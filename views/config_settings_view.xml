<odoo>
  <data>
    <record id="action_config_settings_maya_core" model="ir.actions.act_window">
      <field name="name">Ajustes de Maya</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">res.config.settings</field>
      <field name="view_mode">form</field>
      <field name="target">inline</field>
      <field name="context">{'module' : 'maya_core', 'bin_size': False}</field>
    </record>

    <record model="ir.ui.view" id="res_config_settings_view_form_maya">
      <field name="name">Configuración Maya</field>
      <field name="model">res.config.settings</field>
      <!-- hereda de la vista base de configuraciones --> 
      <field name="inherit_id" ref="base.res_config_settings_view_form" /> 
      <field name="arch" type="xml">
      <!--  busca todos los nodos de tipo app con el atributo name = general_settings
            inside (default): your values will be appended inside the tag
            after: add the content after the tag
            before: add the content before the tag
            replace: replace the content of the tag. -->
        <xpath expr="//app[@name='general_settings']" position="after">
          <!-- string, el texto que aparecerá en el menu lateral-->
          <app data-string="Maya | Core" string="Maya | Core" name="maya_core">
            <h2>Moodle</h2>
            <div class="row mt16 o_settings_container" name="maya_core_moodle_setting_container">

              <!-- contenedor URL Moodle -->
              <div class="col-12 col-lg-6 o_setting_box" title="URL Moodle">
                <div class="o_setting_right_pane">
                 <span class="o_form_label">URL</span>
                 <div class="text-muted">Dirección servidor Moodle</div>
                 <div class="text-muted content-group mt8">
                    <field name="moodle_url" class="text-center oe_inline" />
                  </div>
                </div>
              </div>

              <div class="col-12 col-lg-6 o_setting_box" title="">
                <div class="o_setting_left_pane"/>                
              </div>

              <!-- Nombre de usuario Moodle -->
              <div class="col-12 col-lg-6 o_setting_box" title="Usuario">
                <div class="o_setting_left_pane"/>
                <div class="o_setting_right_pane">
                  <span class="o_form_label">Usuario</span>
                  <div class="text-muted">Usuario (clave) definido en .maya_moodleteacher</div>
                  <div class="text-muted content-group mt8">
                    <field name="moodle_user" class="text-center oe_inline" />
                  </div>
                </div>
              </div>

              <!-- nombre Administrador Aules  -->
              <div class="col-12 col-lg-6 o_setting_box" title="Usuario Administrador">
                <div class="o_setting_left_pane"/>
                <div class="o_setting_right_pane">
                  <span class="o_form_label">Usuario Administrador</span>
                  <div class="text-muted">Usuario administrador (clave) definido en .maya_moodleteacher</div>
                  <div class="text-muted content-group mt8">
                    <field name="moodle_user_admin" class="text-center oe_inline" />
                  </div>
                  </div>
              </div>

            </div>

            <h2>Itaca</h2>
            <div class="row mt16 o_settings_container" name="maya_core_itaca_setting_container">

              <!-- Fichero datos -->
              <div class="col-12 col-lg-6 o_setting_box" title="Nombre del fichero de datos">
                <div class="o_setting_right_pane">
                 <span class="o_form_label">Nombre del fichero de datos</span>
                 <div class="text-muted">Nombre del fichero .csv (debe incluir la extensión) que contiene los datos de los alumnos de Itaca</div>
                 <div class="text-muted content-group mt8">
                    <field name="itaca_students_data" class="text-center oe_inline" />
                  </div>
                </div>
              </div>
            </div>

            <h2>Correo</h2>
            <div class="row mt16 o_settings_container" name="maya_core_itaca_setting_container">
              <!-- Alias maya -->
              <div class="col-12 col-lg-6 o_setting_box" title="URL Moodle">
                <div class="o_setting_right_pane">
                 <span class="o_form_label">Alias correo Maya</span>
                 <div class="text-muted">Alias en la configuración de Odoo del servidor de correo que envia correo con el nombre de Maya</div>
                 <div class="text-muted content-group mt8">
                    <field name="alias_mail_maya" class="text-center oe_inline" />
                  </div>
                </div>
              </div>

              <!-- Alias centro  -->
              <div class="col-12 col-lg-6 o_setting_box" title="URL Moodle">
                <div class="o_setting_right_pane">
                 <span class="o_form_label">Alias correo Centro</span>
                 <div class="text-muted">Alias en la configuración de Odoo del servidor de correo que envia correo con el nombre del Centro</div>
                 <div class="text-muted content-group mt8">
                    <field name="alias_mail_center" class="text-center oe_inline" />
                  </div>
                </div>
              </div>
            </div>
          </app>
        </xpath>
      </field>
    </record>
  </data>
</odoo>